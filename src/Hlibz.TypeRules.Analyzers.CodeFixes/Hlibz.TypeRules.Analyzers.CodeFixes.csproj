<Project Sdk="Microsoft.NET.Sdk">

  <!-- Code fixes for the analyzers. Needs Workspaces, so it can't share their assembly (RS1038). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hlibz.TypeRules.Analyzers\Hlibz.TypeRules.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hlibz.TypeRules.Analyzers.Tests" />
  </ItemGroup>

</Project>
