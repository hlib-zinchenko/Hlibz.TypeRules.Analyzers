<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumes the analyzers the way a real project does: configured in this folder's .editorconfig,
    loaded as an analyzer rather than referenced. Must build clean. With -p:IncludeViolations=true
    it also compiles Violations/ (one file per rule set, plus a broken rule set for TR000), which
    must report exactly Violations/expected-diagnostics.txt: run verify-violations.sh (CI does).
  -->
  <PropertyGroup>
    <!-- Overridable because restore ignores a TargetFramework given on the command line. -->
    <SampleTargetFramework Condition="'$(SampleTargetFramework)' == ''">net10.0</SampleTargetFramework>
    <TargetFramework>$(SampleTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TypeRulesAnalyzerPath)' == ''">
    <ProjectReference Include="..\..\src\Hlibz.TypeRules.Analyzers\Hlibz.TypeRules.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    With TypeRulesAnalyzerPath (a folder of already built analyzer DLLs, such as the package's
    analyzers/dotnet/cs), loads those instead of building the analyzer project. CI runs the packed
    analyzers this way on the oldest supported SDK, with -p:SampleTargetFramework=net8.0.
  -->
  <ItemGroup Condition="'$(TypeRulesAnalyzerPath)' != ''">
    <Analyzer Include="$(TypeRulesAnalyzerPath)/*.dll" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeViolations)' != 'true'">
    <Compile Remove="Violations/**" />
  </ItemGroup>

</Project>
